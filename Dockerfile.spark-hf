# Sử dụng image Spark (Đã cài sẵn Java & Python)
FROM bitnamilegacy/spark:3.4.1

USER root

# 1. Cài đặt các thư viện phụ thuộc cho PySpark
RUN pip install pyspark kafka-python pymongo

# 2. Cài đặt Node.js
RUN apt-get update && \
    apt-get install -y curl && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs

# 3. Copy và Build NestJS app (binance-ingest)
WORKDIR /app/binance-ingest
COPY IT4931/binance-ingest/ /app/binance-ingest/
RUN npm install && npm run build

# 4. Copy toàn bộ code xử lý Spark vào container
WORKDIR /app/spark
COPY IT4931/spark-processing/ /app/spark/

# 5. Cấu hình PORT cho Hugging Face
ENV PORT=7860
EXPOSE 7860

# 6. Script khởi chạy song song (Spark background, NestJS foreground)
RUN echo '#!/bin/bash' > /app/run.sh && \
    echo 'echo "Starting Spark Streaming (Background)..."' >> /app/run.sh && \
    echo 'cd /app/spark && spark-submit --packages org.apache.spark:spark-sql-kafka-0-10_2.12:3.4.1,org.apache.hadoop:hadoop-aws:3.3.4,com.amazonaws:aws-java-sdk-bundle:1.12.262,org.mongodb.spark:mongo-spark-connector_2.12:10.2.1 --master local[*] streaming/ohlc_aggregator.py &' >> /app/run.sh && \
    echo 'echo "Starting NestJS Binance Ingest (Foreground) on port $PORT..."' >> /app/run.sh && \
    echo 'cd /app/binance-ingest && npm run start:prod' >> /app/run.sh

RUN chmod +x /app/run.sh

# 7. Lệnh thực thi khi container khởi động
CMD ["/app/run.sh"]