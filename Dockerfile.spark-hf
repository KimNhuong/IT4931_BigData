# Sử dụng image Spark (Đã cài sẵn Java & Python)
FROM bitnamilegacy/spark:3.4.1

USER root

# 1. Cài đặt các thư viện phụ thuộc cho PySpark
RUN pip install pyspark kafka-python pymongo

# 2. Copy toàn bộ code xử lý Spark vào container
WORKDIR /app/spark
COPY IT4931/spark-processing/ /app/spark/

# 3. Hugging Face Spaces yêu cầu Expose cổng 7860
ENV PORT=7860
EXPOSE 7860

# 4. Script khởi chạy song song
RUN echo '#!/bin/bash' > /app/run.sh && \
    echo 'echo "Starting Spark Streaming (Background)..."' >> /app/run.sh && \
    echo 'spark-submit --master local[*] --packages org.apache.hadoop:hadoop-aws:3.3.4 streaming/ohlc_aggregator.py &' >> /app/run.sh && \
    echo 'echo "Starting Placeholder Web Server (Foreground) on port $PORT..."' >> /app/run.sh && \
    echo 'python -m http.server $PORT' >> /app/run.sh

RUN chmod +x /app/run.sh

# 5. Lệnh thực thi khi container khởi động
CMD ["/app/run.sh"]